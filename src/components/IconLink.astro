---
type IconComponent = (props: Record<string, unknown>) => unknown;
const iconModules = import.meta.glob<{ default: IconComponent }>('./icons/*.astro', { eager: true });

const { href, title, icon } = Astro.props;

const classes = [
  'icon-link',
];

const iconPath = icon
  ? Object.keys(iconModules).find(
      (path) => path.toLowerCase() === `./icons/${icon.toLowerCase()}.astro`,
    )
  : undefined;
const Icon = iconPath ? iconModules[iconPath].default : null;
---
<a class:list={classes} href={href} title={title} aria-label={title}>
  {Icon && <Icon />}
</a>