---
import Home from '~/layouts/Home.astro';
import LatestBook from '~/components/LatestBook.astro';
import LatestBookmarks from '~/components/LatestBookmarks.astro';
import KuzcoCounter from '~/components/KuzcoCounter.astro';
import ButtonLink from '~/components/ButtonLink.astro';
import IconLink from '~/components/IconLink.astro';
---

<Home
  title="Home"
  ogTitle="Tristan Hampton"
  description="My little corner of the internet. Creative coding, pictures, notes and whatever else."
>
  <div class="tile tile-4x2 tile--dotted">
    <p class="h1">Under Construction</p>
  </div>
  <div class="tile tile-2x2 tile--bare">
    <LatestBook />
  </div>
  <div class="tile tile-2x2 tile--bare tile--image">
    <img src="/img/sketches/mindless.png" alt="" />
  </div>
  <div class="tile tile-4x4 tile--shadow">
    <LatestBookmarks limit={3} />
  </div>

  <div class="tile tile-2x2 tile--bare">
    <ButtonLink title={'Me'} href={'/me'} text={'medium'}/>
  </div>

  <div class="tile tile-2x2 tile--bare">
    <ButtonLink title={'Creative'} href={'/creative'} text={'medium'}/>
  </div>

  <div class="tile tile-2x2 tile--bare">
    <ButtonLink title={'Photos'} href={'/pictures'} text={'medium'}/>
  </div>

  <div class="tile tile-1X1 tile--bare">
    <IconLink href={'/me/bookshelf'} title={'Bookshelf'} icon={'book'} />
  </div>

  <div class="tile tile-1X1 tile--bare">
    <IconLink href={'/me/gameshelf'} title={'Gameshelf'} icon={'gamepad'} />
  </div>

  <div class="tile tile-1X1 tile--bare">
    <IconLink href={'/me/movieshelf'} title={'Movieshelf'} icon={'ticket'} />
  </div>
</Home>
