---
import { getCollection } from 'astro:content';
import Default from '~/layouts/Default.astro';

const byNewest = <T extends { data: { date: Date } }>(items: T[]) =>
  items.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const games = byNewest(await getCollection('steam')).slice(0, 8);
const movies = byNewest(await getCollection('letterboxd')).slice(0, 8);
const books = byNewest((await getCollection('goodreads')).filter((b) => b.data.category === 'read')).slice(0, 8);
const albums = byNewest(await getCollection('music')).slice(0, 8);
---

<Default title="Me" description="Personal things relating to Tristan Hampton">
  <div class="banner banner--default">
    <h1>Me</h1>
    <p>
      All of this data is updated hourly with a script on my home server. I've used
      <a href="https://rknight.me/">Robb Knight's</a> tool <a href="https://echo.rknight.me/">Echo</a>,
      which I've modified a tad in order to be able to create new posts as well as update existing
      content. My data sources are Steam, Letterboxd, Goodreads, and Strava.
    </p>
    <p>Let's not pay too close of attention to the Strava dates.</p>
  </div>

  {
    games.length > 0 && (
      <div class="component component--standard-wide">
        <h2>Playing...</h2>
        <ul class="grid-wrapper grid--large">
          {games.map((game) => (
            <li>
              <img
                src={`https://cdn.akamai.steamstatic.com/steam/apps/${game.data.id}/library_600x900.jpg`}
                alt={`icon for ${game.data.title}`}
                loading="lazy"
              />
            </li>
          ))}
        </ul>
        <p>
          <a href="/me/gameshelf/" class="btn-primary">
            View full game list
          </a>
        </p>
      </div>
    )
  }

  {
    movies.length > 0 && (
      <div class="component component--standard-wide">
        <h2>Watching...</h2>
        <ul class="grid-wrapper grid--large">
          {movies.map((movie) => (
            <li>
              {movie.data.poster && (
                <img src={movie.data.poster} alt={`${movie.data.title} Poster`} loading="lazy" />
              )}
              <p class="sr-only">{movie.data.title}</p>
            </li>
          ))}
        </ul>
        <p>
          <a href="/me/movieshelf/" class="btn-primary">
            View full watch list
          </a>
        </p>
      </div>
    )
  }

  {
    books.length > 0 && (
      <div class="component--standard-wide component">
        <h2>Reading...</h2>
        <ul class="grid-wrapper grid--large">
          {books.map((book) => (
            <li>
              <img src={book.data.cover} alt={`${book.data.title} cover`} loading="lazy" />
              <p>
                <em>{book.data.title}</em>
                <br />
                {book.data.author}
              </p>
            </li>
          ))}
        </ul>
        <p>
          <a href="/me/bookshelf/" class="btn-primary">
            View full bookshelf
          </a>
        </p>
      </div>
    )
  }

  {
    albums.length > 0 && (
      <div class="component--standard-wide component">
        <h2>Listening...</h2>
        <ul class="grid-wrapper grid--large">
          {albums.map((album) => (
            <li>
              <img src={album.data.cover} alt={`${album.data.title} cover`} loading="lazy" />
              <p>
                <em>{album.data.title}</em>
                <br />
                {album.data.artist}
              </p>
            </li>
          ))}
        </ul>
        <p>
          <a href="/me/musicshelf/" class="btn-primary">
            View full musicshelf
          </a>
        </p>
      </div>
    )
  }
</Default>
